{
  "name": "dsh-relay-isolation",
  "version": "0.4.1",
  "description": "Provision a separate DSH_HOME (minimal profile + launcher) for the AgentRouter relay, and give the sandboxed agent controlled network egress.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlannerFranklin/dsh-relay-isolation.git"
  },
  "homepage": "https://github.com/AlannerFranklin/dsh-relay-isolation#readme",
  "bugs": {
    "url": "https://github.com/AlannerFranklin/dsh-relay-isolation/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "icon": "icon.svg",
  "keywords": [
    "dsh",
    "deepseek",
    "harness",
    "dsh-plugin",
    "dsh-bundle",
    "agentrouter",
    "relay",
    "isolation",
    "sandbox",
    "network"
  ],
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/provision.test.mjs test/tool.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}

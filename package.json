{
  "name": "dsh-relay-isolation",
  "version": "0.1.0",
  "description": "Provision a separate DSH_HOME (minimal profile + launcher) for the AgentRouter relay, so the relay never runs inside your main Harness profile.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "icon": "icon.svg",
  "keywords": [
    "dsh",
    "deepseek",
    "harness",
    "dsh-plugin",
    "dsh-bundle",
    "agentrouter",
    "relay",
    "isolation",
    "profile"
  ],
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/provision.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
